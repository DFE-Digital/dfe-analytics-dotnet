<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>DfeAnalytics.EFCore</PackageId>
    <OutputType>Exe</OutputType>
    <Description>Entity Framework Core integration for DfE Analytics.</Description>
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <!-- temp -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dfe.Analytics.EFCore.Tests" />
  </ItemGroup>

  <!--
    A single net8.0 build with the lowest supported versions as minimums, so apps on newer runtimes can use any
    EF Core version from 8 onwards rather than being forced onto the version matching their target framework.
    Only Microsoft.EntityFrameworkCore.Relational is referenced; the database provider is the app's choice.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dfe.Analytics.AspNetCore\Dfe.Analytics.AspNetCore.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Dfe.Analytics.Core\Dfe.Analytics.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Package\**\*" Pack="true" PackagePath="$(RecursiveDir)" />
  </ItemGroup>

</Project>
