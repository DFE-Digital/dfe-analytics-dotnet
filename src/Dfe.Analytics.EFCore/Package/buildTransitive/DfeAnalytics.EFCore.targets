<Project>

  <PropertyGroup Condition="'$(DfeAnalyticsGenerateDesignTimeServicesReference)' != 'false'">
    <CoreCompileDependsOn>
      CreateDfeAnalyticsDesignTimeServicesReference;
      $(CoreCompileDependsOn)
    </CoreCompileDependsOn>
  </PropertyGroup>

  <Target Name="CreateDfeAnalyticsDesignTimeServicesReference">

    <PropertyGroup>
      <!--
        DfeAnalyticsDbContext is an assembly-qualified type name - 'Some.Namespace.MyDbContext, MyAssembly'.
        Only the assembly it names needs the reference; EF Core's tooling reads the attribute from the target
        and startup assemblies of the project it is run against. When no assembly can be determined - the
        property is unset, or holds a bare type name - fall back to emitting it everywhere.
      -->
      <DfeAnalyticsDbContextAssemblyName Condition="'$(DfeAnalyticsDbContext)' != '' And $(DfeAnalyticsDbContext.Contains(','))">$([System.Text.RegularExpressions.Regex]::Replace($(DfeAnalyticsDbContext), '^[^,]*,\s*', ''))</DfeAnalyticsDbContextAssemblyName>
      <DfeAnalyticsDbContextAssemblyName Condition="'$(DfeAnalyticsDbContextAssemblyName)' != ''">$([System.Text.RegularExpressions.Regex]::Replace($(DfeAnalyticsDbContextAssemblyName), ',.*', ''))</DfeAnalyticsDbContextAssemblyName>

      <DfeAnalyticsEmitDesignTimeServicesReference>true</DfeAnalyticsEmitDesignTimeServicesReference>
      <DfeAnalyticsEmitDesignTimeServicesReference Condition="'$(DfeAnalyticsGenerateDesignTimeServicesReference)' == '' And '$(DfeAnalyticsDbContextAssemblyName)' != '' And '$(DfeAnalyticsDbContextAssemblyName)' != '$(AssemblyName)'">false</DfeAnalyticsEmitDesignTimeServicesReference>

      <DesignTimeServicesReferencePath>$(IntermediateOutputPath)Dfe.Analytics.EFCore.DesignTimeServices.g.cs</DesignTimeServicesReferencePath>

      <DesignTimeServicesReferenceSource>
        <![CDATA[
// <auto-generated/>

[assembly: Microsoft.EntityFrameworkCore.Design.DesignTimeServicesReference("Dfe.Analytics.EFCore.DfeAnalyticsDesignTimeServices, Dfe.Analytics.EFCore")]
]]>
      </DesignTimeServicesReferenceSource>
    </PropertyGroup>

    <ItemGroup Condition="'$(DfeAnalyticsEmitDesignTimeServicesReference)' == 'true'">
      <Compile Include="$(DesignTimeServicesReferencePath)" />
    </ItemGroup>

    <WriteLinesToFile Condition="'$(DfeAnalyticsEmitDesignTimeServicesReference)' == 'true'"
                      File="$(DesignTimeServicesReferencePath)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="$(DesignTimeServicesReferenceSource)" />
  </Target>

  <Target Name="CreateDfeAnalyticsDirectory"
          AfterTargets="Publish"
          Condition="'$(DfeAnalyticsDbContext)' != '' And '$(IsPublishable)' == 'true'">

    <PropertyGroup>
      <AnalyticsDirName>dfe-analytics</AnalyticsDirName>

      <ConfigFileName>db-config.json</ConfigFileName>

      <!--
        Run the tools with the app's deps.json and runtimeconfig.json so the app's dependencies and shared frameworks
        resolve exactly as they do when the app itself runs (the same approach 'dotnet ef' uses).
      -->
      <CliExec>dotnet exec --depsfile $(AssemblyName).deps.json --runtimeconfig $(AssemblyName).runtimeconfig.json Dfe.Analytics.EFCore.dll</CliExec>

      <CliArgs>config create</CliArgs>
      <CliArgs>$(CliArgs) --path $(AnalyticsDirName)/$(ConfigFileName)</CliArgs>
      <CliArgs>$(CliArgs) --dbcontext "$(DfeAnalyticsDbContext)"</CliArgs>
    </PropertyGroup>

    <MakeDir Directories="$(PublishDir)/$(AnalyticsDirName)" />

    <Exec Command="$(CliExec) $(CliArgs)"
          WorkingDirectory="$(PublishDir)"
          LogStandardErrorAsError="true" />

    <PropertyGroup>
      <ApplyConfigScript>
        <![CDATA[
#!/bin/sh

cd "%24(dirname "$0")"
cd ..
$(CliExec) config apply --path $(AnalyticsDirName)/$(ConfigFileName) "$@"
]]>
      </ApplyConfigScript>
    </PropertyGroup>

    <WriteLinesToFile File="$(PublishDir)$(AnalyticsDirName)/apply-config.sh"
                      Overwrite="true"
                      Lines="$(ApplyConfigScript)" />

  </Target>

</Project>
