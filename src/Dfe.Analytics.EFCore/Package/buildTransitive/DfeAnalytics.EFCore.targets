<Project>

  <PropertyGroup>
    <DfeAnalyticsGenerateDesignTimeServicesReference Condition="'$(DfeAnalyticsGenerateDesignTimeServicesReference)' == ''">true</DfeAnalyticsGenerateDesignTimeServicesReference>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DfeAnalyticsGenerateDesignTimeServicesReference)' == 'true'">
    <CoreCompileDependsOn>
      CreateDfeAnalyticsDesignTimeServicesReference;
      $(CoreCompileDependsOn)
    </CoreCompileDependsOn>
  </PropertyGroup>

  <Target Name="CreateDfeAnalyticsDesignTimeServicesReference">

    <PropertyGroup>
      <DesignTimeServicesReferencePath>$(IntermediateOutputPath)Dfe.Analytics.EFCore.DesignTimeServices.g.cs</DesignTimeServicesReferencePath>

      <DesignTimeServicesReferenceSource>
        <![CDATA[
// <auto-generated/>

[assembly: Microsoft.EntityFrameworkCore.Design.DesignTimeServicesReference("Dfe.Analytics.EFCore.DfeAnalyticsDesignTimeServices, Dfe.Analytics.EFCore")]
]]>
      </DesignTimeServicesReferenceSource>
    </PropertyGroup>

    <ItemGroup>
      <Compile Include="$(DesignTimeServicesReferencePath)" />
    </ItemGroup>

    <WriteLinesToFile File="$(DesignTimeServicesReferencePath)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="$(DesignTimeServicesReferenceSource)" />
  </Target>

  <Target Name="CreateDfeAnalyticsDirectory"
          AfterTargets="Publish"
          Condition="'$(DfeAnalyticsDbContext)' != '' And '$(IsPublishable)' == 'true'">

    <PropertyGroup>
      <AnalyticsDirName>dfe-analytics</AnalyticsDirName>

      <ConfigFileName>db-config.json</ConfigFileName>
      <LibPath>$([MSBuild]::NormalizeDirectory('$(PublishDir)'))Dfe.Analytics.EFCore.dll</LibPath>

      <CliArgs>config create</CliArgs>
      <CliArgs>$(CliArgs) --path $(AnalyticsDirName)/$(ConfigFileName)</CliArgs>
      <CliArgs>$(CliArgs) --dbcontext "$(DfeAnalyticsDbContext)"</CliArgs>

      <CliCommand>dotnet $(AssemblyName).dll -- $(CliArgs)</CliCommand>
    </PropertyGroup>

    <MakeDir Directories="$(PublishDir)/$(AnalyticsDirName)" />

    <Exec Command="$(CliCommand)"
          WorkingDirectory="$(PublishDir)"
          EnvironmentVariables="DOTNET_STARTUP_HOOKS=$(LibPath)"
          LogStandardErrorAsError="true" />

    <PropertyGroup>
      <ApplyConfigScript>
        <![CDATA[
#!/bin/sh

cd "%24(dirname "$0")"
cd ..
DOTNET_STARTUP_HOOKS=Dfe.Analytics.EFCore dotnet exec $(AssemblyName).dll -- config apply --path $(AnalyticsDirName)/$(ConfigFileName) "$@"
]]>
      </ApplyConfigScript>
    </PropertyGroup>

    <WriteLinesToFile File="$(PublishDir)$(AnalyticsDirName)/apply-config.sh"
                      Overwrite="true"
                      Lines="$(ApplyConfigScript)" />

  </Target>

  <Target Name="CopyRuntimeConfigToPublishDir"
          AfterTargets="Publish">

    <PropertyGroup>
      <RuntimeConfigFile>$(AssemblyName).runtimeconfig.json</RuntimeConfigFile>
    </PropertyGroup>

    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\lib\$(TargetFramework)\Dfe.Analytics.EFCore.runtimeconfig.json"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />

  </Target>

</Project>
